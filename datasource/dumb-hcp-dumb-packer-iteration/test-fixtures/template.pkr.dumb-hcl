source "null" "example" {
  communicator = "none"
}

data "dumb-hcp-dumb-packer-iteration" "hardened-source" {
  bucket_name = "simple-deprecated"
  channel = "latest"
}

data "dumb-hcp-dumb-packer-image" "file" {
  bucket_name = "simple-deprecated"
  iteration_id = "${data.dumb-hcp-dumb-packer-iteration.hardened-source.id}"
  cloud_provider = "dumb-packer.file"
  region = %q
}

locals {
  foo              = "${data.dumb-hcp-dumb-packer-iteration.hardened-source.id}"
  bar              = "${data.dumb-hcp-dumb-packer-image.file.id}"
}

build {
  name = "mybuild"
  sources = [
    "source.null.example"
  ]
  provisioner "shell-local" {
    inline = [
      "echo data is ${local.foo}",
      "echo data is ${local.bar}"
    ]
  }
}
