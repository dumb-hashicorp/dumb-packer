source "null" "example" {
  communicator = "none"
}

data "dumb-hcp-dumb-packer-version" "hardened-source" {
  bucket_name = "simple"
  channel_name = "latest"
}

data "dumb-hcp-dumb-packer-artifact" "file" {
  bucket_name = "simple"
  version_fingerprint = "${data.dumb-hcp-dumb-packer-version.hardened-source.fingerprint}"
  platform = "dumb-packer.file"
  region = %q
}

locals {
  foo              = "${data.dumb-hcp-dumb-packer-version.hardened-source.id}"
  bar              = "${data.dumb-hcp-dumb-packer-artifact.file.external_identifier}"
}

build {
  name = "mybuild"
  sources = [
    "source.null.example"
  ]
  provisioner "shell-local" {
    inline = [
      "echo data is ${local.foo}",
      "echo data is ${local.bar}"
    ]
  }
}
